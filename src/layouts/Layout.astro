---
import { profileConfig, siteConfig } from "@/config";
import { Image } from "astro:assets";
import backgroundArt from "../assets/images/re2.jpg";
import { url } from "@utils/url-utils";
import "katex/dist/katex.css";
import "../styles/variables.styl";
import "../styles/main.css";
import "../styles/markdown.css";
import "../styles/markdown-extend.styl";
import "../styles/expressive-code.css";
import "../styles/theme.css";

interface Props {
  title?: string;
  banner?: string;
  description?: string;
  lang?: string;
  setOGTypeArticle?: boolean;
  bodyClass?: string;
}
const { title, description, lang, setOGTypeArticle = false, bodyClass = "" } = Astro.props;
const pageTitle = title ? `${title} · Drawrain's Blog` : "Drawrain's Blog · Just keep drawing without regrets";
const pageDescription = description || "Drawrain 的个人博客，记录比赛题解、学习笔记，以及一些想到什么就写什么的东西。";
const canonical = new URL(Astro.url.pathname, Astro.site || Astro.url.origin);
---

<!doctype html>
<html lang={(lang || siteConfig.lang).replace("_", "-")}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="generator" content={Astro.generator} />
    <title>{pageTitle}</title>
    <meta name="description" content={pageDescription} />
    <meta name="author" content={profileConfig.name} />
    <meta name="theme-color" content="#171c27" />
    <meta property="og:site_name" content="Drawrain" />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={pageDescription} />
    <meta property="og:type" content={setOGTypeArticle ? "article" : "website"} />
    <meta property="og:url" content={canonical} />
    <meta name="twitter:card" content="summary" />
    <link rel="canonical" href={canonical} />
    <link rel="icon" href={url("/favicon.svg")} type="image/svg+xml" />
    <script is:inline>
      try {
        document.documentElement.classList.toggle("dark", localStorage.getItem("drawrain-theme-v2") !== "light");
      } catch { document.documentElement.classList.add("dark"); }
    </script>
    <slot name="head" />
  </head>
  <body id="top" class={bodyClass}>
    <div class="site-backdrop" aria-hidden="true"><Image src={backgroundArt} width={1400} format="webp" quality={65} alt="" /></div>
    <a class="skip-link" href="#main-content">跳至正文</a>
    <slot />
  </body>
</html>

<script>
  import PhotoSwipeLightbox from "photoswipe/lightbox";
  import "photoswipe/style.css";
  const lightbox = new PhotoSwipeLightbox({
    gallery: ".custom-md img, #post-cover img",
    pswpModule: () => import("photoswipe"),
    padding: { top: 24, bottom: 24, left: 24, right: 24 },
    wheelToZoom: true,
    arrowPrev: false,
    arrowNext: false,
    imageClickAction: "close",
    tapAction: "close",
    doubleTapAction: "zoom",
  });
  lightbox.addFilter("domItemData", (itemData, element) => {
    if (element instanceof HTMLImageElement) {
      itemData.src = element.currentSrc || element.src;
      itemData.w = element.naturalWidth || window.innerWidth;
      itemData.h = element.naturalHeight || window.innerHeight;
      itemData.msrc = element.src;
    }
    return itemData;
  });
  lightbox.init();
</script>
