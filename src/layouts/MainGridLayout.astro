---
import type { MarkdownHeading } from "astro";
import Navbar from "@components/Navbar.astro";
import Footer from "@components/Footer.astro";
import Layout from "./Layout.astro";
interface Props {
  title?: string;
  banner?: string;
  description?: string;
  lang?: string;
  setOGTypeArticle?: boolean;
  headings?: MarkdownHeading[];
  articleLayout?: boolean;
  homePage?: boolean;
}
const { title, banner, description, lang, setOGTypeArticle, articleLayout = false, homePage = false } = Astro.props;
---
<Layout title={title} banner={banner} description={description} lang={lang} setOGTypeArticle={setOGTypeArticle} bodyClass={homePage ? "home-page" : ""}>
  <slot slot="head" name="head" />
  <Navbar />
  <slot name="hero" />
  <main id="main-content" class:list={["site-container site-main", { "article-main": articleLayout }]} tabindex="-1">
    <slot />
  </main>
  <div class="site-container"><Footer /></div>
</Layout>
