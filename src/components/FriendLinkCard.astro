---
import type { FriendLinkItem } from "../constants/friends";
import ImageWrapper from "./misc/ImageWrapper.astro";
interface Props { friend: FriendLinkItem; }
const { friend } = Astro.props;
---
<a href={friend.url} target="_blank" rel="noopener noreferrer" aria-label={`访问 ${friend.siteName || friend.name}`} class="friend-card">
	<span class="friend-preview" aria-hidden="true"><strong>{friend.siteName || friend.name}</strong><span>{friend.description.trim() || new URL(friend.url).hostname}</span><small>在新窗口访问 ↗</small></span>
	<div class="friend-identity"><div class="friend-avatar"><ImageWrapper src={friend.avatar} alt={`${friend.name} 的头像`} class="friend-avatar-image" /></div><div class="friend-name"><h2>{friend.name}</h2><p>{friend.siteName || new URL(friend.url).hostname}</p></div><span class="friend-arrow" aria-hidden="true">↗</span></div>
	{friend.description.trim() && <p class="friend-description">{friend.description}</p>}
	<div class="friend-domain"><span>{new URL(friend.url).hostname}</span><span class="friend-visit">去串门 <span aria-hidden="true">→</span></span></div>
</a>
<style>
	.friend-card { position:relative;display: flex; flex-direction: column; min-width: 0; border: 1px solid transparent; border-radius: 24px; background: var(--surface); padding: 26px; box-shadow:var(--panel-shadow); transition: border-color .25s, transform .25s, background .25s, box-shadow .25s; }
	.friend-preview { position:absolute;left:12px;right:12px;bottom:calc(100% + 12px);padding:15px 18px;border:1px solid var(--line);border-radius:13px;background:var(--surface);box-shadow:0 10px 30px #080d1744;opacity:0;visibility:hidden;transform:translateY(5px);pointer-events:none;transition:opacity .18s,transform .18s,visibility .18s;z-index:5;display:flex;flex-direction:column;gap:5px; }
	.friend-preview strong { font-size:14px; } .friend-preview>span { color:var(--muted);font-size:12px; } .friend-preview small { color:var(--accent);font-size:11px; }
	.friend-card:hover .friend-preview,.friend-card:focus-visible .friend-preview { opacity:1;visibility:visible;transform:translateY(0); }
	.friend-card:hover,.friend-card:focus-visible { background: color-mix(in srgb, var(--accent) 4%, var(--surface)); border-color: color-mix(in srgb, var(--accent) 38%, var(--line)); transform: translateY(-2px); box-shadow:var(--panel-shadow-hover); }
	.friend-identity { display: flex; align-items: center; gap: 15px; }
	.friend-avatar { width: 58px; height: 58px; flex: 0 0 auto; overflow: hidden; border-radius: 18px; background: var(--soft); border: 1px solid var(--line); transition: transform .2s; }
	.friend-card:hover .friend-avatar,.friend-card:focus-visible .friend-avatar { transform: rotate(6deg) scale(1.05); }
	.friend-avatar :global(.friend-avatar-image), .friend-avatar :global(img) { width: 100%; height: 100%; object-fit: cover; }
	.friend-name { flex: 1; min-width: 0; }
	.friend-name h2 { font-size: 19px; font-weight: 600; line-height: 1.3; overflow-wrap: anywhere; }
	.friend-name p { color: var(--muted); font-size: 11px; margin-top: 7px; overflow-wrap: anywhere; }
	.friend-arrow { align-self: start; font-size: 22px; color: var(--accent); transition: transform .2s; }
	.friend-card:hover .friend-arrow,.friend-card:focus-visible .friend-arrow { transform: translate(2px, -2px); }
	.friend-description { margin-top: 19px; font-size: 12px; line-height: 1.8; color: var(--muted); }
	.friend-domain { display: flex; flex-wrap: wrap; gap: 10px; justify-content: space-between; border-top: 1px solid var(--line); padding-top: 15px; margin-top: 22px; font-size: 10px; color: var(--muted); }
	.friend-domain > span:last-child { color: var(--accent); }
	.friend-visit { display:inline-flex;align-items:center;gap:5px; }
	.friend-visit > span { display:inline-block;transition:transform .25s; }
	.friend-card:hover .friend-visit > span,.friend-card:focus-visible .friend-visit > span { transform:translateX(4px); }
	@media(prefers-reduced-motion:reduce) { .friend-card,.friend-preview,.friend-avatar,.friend-arrow,.friend-visit > span { transition:none; } .friend-card:hover,.friend-card:focus-visible,.friend-card:hover .friend-avatar,.friend-card:focus-visible .friend-avatar,.friend-card:hover .friend-arrow,.friend-card:focus-visible .friend-arrow,.friend-card:hover .friend-visit > span,.friend-card:focus-visible .friend-visit > span,.friend-preview { transform:none; } }
</style>
