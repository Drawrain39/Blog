---
import { getSortedPosts } from "../utils/content-utils";
import { getPostUrlBySlug, pathsEqual, url } from "../utils/url-utils";
import Search from "./Search.svelte";
import Brand from "./Brand.astro";

const links = [
	{ name: "首页", href: "/" },
	{ name: "归档", href: "/archive/" },
	{ name: "关于", href: "/about/" },
	{ name: "友链", href: "/friends/" },
];
const currentPath = Astro.url.pathname;
const posts = (await getSortedPosts()).filter((post) => !post.data.draft).map((post) => ({
	title: post.data.title,
	url: getPostUrlBySlug(post.slug),
	description: post.data.description,
	category: post.data.category || "随笔",
	tags: post.data.tags,
}));
---

<header class="journal-header" id="navbar">
	<div class="header-inner">
		<a class="wordmark" href={url("/")} aria-label="Drawrain 的博客首页">
			<span class="brand-copy"><Brand class="header-brand" /><Brand variant="wordmark" class="header-brand-compact" /><span class="brand-caption">Just keep drawing without regrets</span></span>
		</a>
		<nav class="desktop-navigation" aria-label="主导航">
			{links.map((link) => <a href={url(link.href)} aria-current={pathsEqual(currentPath, url(link.href)) ? "page" : undefined}>{link.name}</a>)}
		</nav>
		<div class="header-actions">
			<Search {posts} client:load />
			<button class="icon-button music-switch" data-music-toggle type="button" aria-label="打开音乐播放器" aria-controls="drawrain-music-panel" aria-expanded="false" title="听首歌">
				<svg width="19" height="19" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" aria-hidden="true"><path d="M9 18V5l11-2v13M9 8l11-2"/><ellipse cx="6" cy="18" rx="3" ry="2.5"/><ellipse cx="17" cy="16" rx="3" ry="2.5"/></svg>
			</button>
			<span class="action-divider" aria-hidden="true"></span>
			<button class="icon-button theme-switch" id="journal-theme-switch" type="button" aria-label="切换到深色模式" title="切换到深色模式">
				<svg class="moon-icon" width="19" height="19" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true"><path d="M20.8 13.1A8.8 8.8 0 0 1 10.9 3.2 8.8 8.8 0 1 0 20.8 13.1Z" /></svg>
				<svg class="sun-icon" width="19" height="19" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true"><circle cx="12" cy="12" r="4"/><path d="M12 2v2m0 16v2M2 12h2m16 0h2M5 5l1.5 1.5m11 11L19 19M5 19l1.5-1.5m11-11L19 5"/></svg>
			</button>
			<a class="github-link icon-button" href="https://github.com/Drawrain39" target="_blank" rel="noopener noreferrer" aria-label="Drawrain 的 GitHub（新窗口）" title="GitHub">
				<svg width="20" height="20" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M12 .9a11.1 11.1 0 0 0-3.51 21.63c.55.1.76-.24.76-.54v-2.06c-3.09.67-3.74-1.31-3.74-1.31-.5-1.28-1.23-1.62-1.23-1.62-1.01-.69.08-.68.08-.68 1.11.08 1.7 1.14 1.7 1.14.99 1.69 2.59 1.2 3.22.92.1-.72.39-1.21.7-1.49-2.47-.28-5.06-1.23-5.06-5.49 0-1.21.43-2.2 1.14-2.97-.11-.28-.49-1.41.11-2.93 0 0 .93-.3 3.05 1.14A10.6 10.6 0 0 1 12 6.27c.94 0 1.89.13 2.78.37 2.12-1.44 3.05-1.14 3.05-1.14.6 1.52.22 2.65.11 2.93.71.77 1.14 1.76 1.14 2.97 0 4.27-2.6 5.2-5.08 5.48.4.35.75 1.02.75 2.06v3.05c0 .3.2.64.76.53A11.1 11.1 0 0 0 12 .9Z"/></svg>
			</a>
			<details class="mobile-menu" id="journal-mobile-menu">
				<summary class="icon-button" aria-label="打开导航菜单"><svg width="21" height="21" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true"><path d="M4 7h16M4 12h16M4 17h16"/></svg></summary>
				<nav aria-label="移动端导航">
					{links.map((link) => <a href={url(link.href)} aria-current={pathsEqual(currentPath, url(link.href)) ? "page" : undefined}><span>{link.name}</span><span aria-hidden="true">↗</span></a>)}
					<a href="https://github.com/Drawrain39" target="_blank" rel="noopener noreferrer"><span>GitHub</span><span aria-hidden="true">↗</span></a>
				</nav>
			</details>
		</div>
	</div>
</header>

<script>
	let navigationController: AbortController | undefined;
	function initializeNavigation() {
		navigationController?.abort();
		navigationController = new AbortController();
		const { signal } = navigationController;
		const themeButton = document.getElementById("journal-theme-switch");
		const mobileMenu = document.getElementById("journal-mobile-menu") as HTMLDetailsElement | null;
		function updateThemeButton() {
			const dark = document.documentElement.classList.contains("dark");
			const label = dark ? "切换到浅色模式" : "切换到深色模式";
			document.querySelector('meta[name="theme-color"]')?.setAttribute("content", dark ? "#17232d" : "#f3f7fb");
			themeButton?.setAttribute("aria-label", label);
			themeButton?.setAttribute("title", label);
		}
		updateThemeButton();
		themeButton?.addEventListener("click", () => {
			const dark = document.documentElement.classList.toggle("dark");
			try { localStorage.setItem("drawrain-theme-v3", dark ? "dark" : "light"); } catch { /* Storage can be disabled by the browser. */ }
			updateThemeButton();
			document.dispatchEvent(new Event("drawrain:theme-change"));
		}, { signal });
		document.addEventListener("drawrain:theme-change", updateThemeButton, { signal });
		document.addEventListener("click", (event) => {
			if (event.target instanceof Node && !mobileMenu?.contains(event.target)) mobileMenu?.removeAttribute("open");
		}, { signal });
		document.addEventListener("keydown", (event) => {
			if (event.key === "Escape") mobileMenu?.removeAttribute("open");
		}, { signal });
	}
	initializeNavigation();
	document.addEventListener("astro:page-load", initializeNavigation);
</script>

<style>
	.journal-header { position: relative; z-index: 50; width:100%;margin:0 0 28px;border:0;border-bottom:1px solid var(--line);background:var(--surface); }
	.header-inner { width:min(1180px,calc(100% - 48px));margin-inline:auto;padding:10px 0;min-height:84px;display:flex;align-items:center;justify-content:space-between;gap:24px; }
	.wordmark { display: flex; align-items: center; color: var(--ink); text-decoration: none; flex-shrink: 0; --brand-rain: var(--accent); --brand-star: var(--rose); }
	.brand-copy { display: flex; flex-direction: column; gap: 1px; }
	.brand-copy :global(.header-brand) { width: 192px; height: auto; }
	.brand-copy :global(.header-brand-compact) { display: none; height: auto; }
	.wordmark :global(.header-brand > g:first-child > path), .wordmark :global(.header-brand > g:last-child > path:last-child), .wordmark :global(.header-brand-compact > path:last-child) { transform-box:fill-box;transform-origin:center;transition:transform .28s ease,filter .28s ease; }
	.wordmark:is(:hover,:focus-visible) :global(.header-brand > g:first-child > path:first-child) { transform:translateY(-1.5px) scale(1.03); }
	.wordmark:is(:hover,:focus-visible) :global(.header-brand > g:first-child > path:last-child), .wordmark:is(:hover,:focus-visible) :global(.header-brand > g:last-child > path:last-child), .wordmark:is(:hover,:focus-visible) :global(.header-brand-compact > path:last-child) { transform:rotate(18deg) scale(1.2);filter:drop-shadow(0 0 2px var(--brand-star)); }
	.brand-caption { padding-left: 44px; font-size: 9px; color: var(--muted); line-height: 1.4; }
	.desktop-navigation { display: flex; align-items: center; gap: 6px; margin-left: auto; margin-right: 12px; }
	.desktop-navigation a { position:relative;padding: 9px 17px; font-size: 14px; font-weight: 600; border-radius: 11px; color: var(--muted); text-decoration: none; transition: color .2s, background .2s,transform .2s; }
	.desktop-navigation a::after { content:"";position:absolute;left:17px;right:17px;bottom:6px;height:1px;border-radius:1px;background:var(--accent);transform:scaleX(0);transform-origin:left center;transition:transform .24s ease; }
	.desktop-navigation a:hover,.desktop-navigation a:focus-visible { color: var(--ink); background: var(--soft); }
	.desktop-navigation a:is(:hover,:focus-visible)::after { transform:scaleX(1); }
	.desktop-navigation a:active { transform:translateY(1px); }
	.desktop-navigation a[aria-current="page"] { color: var(--accent); background:var(--soft); }
	.header-actions { display: flex; align-items: center; gap: 9px; }
	.icon-button { display: inline-flex; align-items: center; justify-content: center; width: 36px; height: 36px; padding: 0; border: 0; background: transparent; color: var(--muted); cursor: pointer; border-radius: 11px; transition: color .2s, background .2s,transform .2s; }
	.icon-button:hover,.icon-button:focus-visible { color: var(--accent); background: var(--soft); }
	.icon-button > svg { transition:transform .22s ease; }
	.icon-button:is(:hover,:focus-visible) > svg { transform:translateY(-2px); }
	.icon-button:active { transform:translateY(1px) scale(.97); }
	.icon-button:active > svg { transform:none; }
	.action-divider { width: 1px; height: 17px; background: var(--line); margin: 0 3px; }
	.sun-icon { display: none; }
	:global(.dark) .moon-icon { display: none; }
	:global(.dark) .sun-icon { display: block; }
	.mobile-menu { display: none; }
	:global(.home-page) .journal-header { position:absolute;inset:0 0 auto;width:100%;max-width:none;margin:0;border:0;border-bottom:1px solid #ffffff1a;border-radius:0;background:linear-gradient(90deg,#174d75b3,#163d5dd1);box-shadow:none;backdrop-filter:blur(12px);-webkit-backdrop-filter:blur(12px); }
	:global(.home-page) .header-inner { width:min(1180px,calc(100% - 48px));min-height:84px;margin-inline:auto;padding:10px 0; }
	:global(.home-page) .wordmark { color:#f2faff;--brand-rain:#b4ebef;--brand-star:#d1f0df; }
	:global(.home-page) .brand-caption { color:#d4e8f3; }
	:global(.home-page) .desktop-navigation a,:global(.home-page) .icon-button { color:#e0eff9; }
	:global(.home-page) .desktop-navigation a:is(:hover,:focus-visible,[aria-current="page"]),:global(.home-page) .icon-button:is(:hover,:focus-visible) { color:#f5ffff;background:#d4efff1f; }
	:global(.home-page) .desktop-navigation a::after { background:#b4ebef; }
	:global(.home-page) .action-divider { background:#ffffff26; }
	:global(.home-page) .header-actions :global(.search-trigger) { color:#e0eff9;background:#10365459;border-color:#d4efff33; }
	:global(.home-page) .header-actions :global(.search-trigger:hover) { color:#fff;border-color:#d4efff99; }
	:global(.home-page) .header-actions :global(.search-trigger kbd) { color:#d4e8f3; }
	@media (max-width: 1000px) {
		.desktop-navigation { gap: 4px; margin-right: 12px; }
		.desktop-navigation a { padding-right: 12px; padding-left: 12px; }
		.desktop-navigation a::after { left:12px;right:12px; }
		.header-inner { gap: 15px; }
		.brand-caption { font-size: 8px; }
	}
	@media (max-width: 760px) {
		.journal-header { margin-bottom:20px; }
		.header-inner { width:calc(100% - 32px);min-height:74px;padding:10px 0;gap:12px; }
		.brand-copy :global(.header-brand) { width: 185px; }
		.brand-caption { font-size: 8px; }
		.desktop-navigation, .github-link, .action-divider { display: none; }
		.header-actions { gap: 3px; }
		.mobile-menu { display: block; }
		.mobile-menu summary { list-style: none; }
		.mobile-menu summary::-webkit-details-marker { display: none; }
		.mobile-menu nav { position: absolute; top: calc(100% + 8px); left:16px;right:16px;padding:10px;border-radius:20px;background:var(--surface);border:1px solid var(--line);box-shadow:0 12px 32px color-mix(in srgb,var(--ink) 10%,transparent); }
		.mobile-menu nav a { display: flex; align-items: center; justify-content: space-between; padding: 14px 16px; border-radius: 10px; color: var(--ink); text-decoration: none; font-size: 14px; }
		.mobile-menu nav a:hover { background: var(--soft); }
		.mobile-menu nav a[aria-current="page"] { color: var(--accent); background: color-mix(in srgb, var(--accent) 9%, transparent); }
		.mobile-menu nav a > span:last-child { color: var(--muted); }
		.mobile-menu nav a > span:last-child { transition:transform .2s ease; }
		.mobile-menu nav a:is(:hover,:focus-visible) > span:last-child { transform:translate(2px,-2px); }
		:global(.home-page) .header-inner { width:calc(100% - 32px);min-height:74px;padding:10px 0; }
		:global(.home-page) .mobile-menu nav { left:16px;right:16px; }
	}
	@media (max-width: 420px) { .header-inner { gap:6px; } .header-actions { gap:0; } .icon-button { width:32px;height:34px; } .header-actions :global(.search-trigger) { width:32px;height:34px; } .brand-caption { display: none; } .brand-copy :global(.header-brand) { display: none; } .brand-copy :global(.header-brand-compact) { display: block; width:clamp(108px,32vw,134px); } }
	@media(prefers-reduced-motion:reduce) {
		.desktop-navigation a,.desktop-navigation a::after,.icon-button,.icon-button > svg,.mobile-menu nav a > span:last-child { transition:none; }
		.desktop-navigation a:active,.icon-button:is(:hover,:focus-visible,:active),.icon-button:is(:hover,:focus-visible,:active) > svg,.mobile-menu nav a:is(:hover,:focus-visible) > span:last-child { transform:none; }
		.wordmark :global(.header-brand > g:first-child > path),.wordmark :global(.header-brand > g:last-child > path:last-child),.wordmark :global(.header-brand-compact > path:last-child) { transition:none; }
		.wordmark:is(:hover,:focus-visible) :global(.header-brand > g:first-child > path),.wordmark:is(:hover,:focus-visible) :global(.header-brand > g:last-child > path:last-child),.wordmark:is(:hover,:focus-visible) :global(.header-brand-compact > path:last-child) { transform:none;filter:none; }
	}
</style>
