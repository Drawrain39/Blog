---
import type { CollectionEntry } from "astro:content";
import { getPostUrlBySlug, getCategoryUrl, getTagUrl } from "@utils/url-utils";
interface Props { entry: CollectionEntry<"posts">; index?: number; }
const { entry } = Astro.props;
const { title, category, description, tags, published } = entry.data;
const { remarkPluginFrontmatter } = await entry.render();
const date = published.toISOString().slice(0,10);
const postUrl = getPostUrlBySlug(entry.slug);
---
<article class="anime-post">
  <div class="post-copy">
    <div class="post-meta"><a class="category-pill" href={getCategoryUrl(category)}>{category || "随记"}</a><time datetime={date}>{date.replaceAll("-", ".")}</time>{entry.data.draft && <span class="draft-badge">草稿</span>}</div>
    <h3><a href={postUrl}><span class="post-title-text">{title}</span></a></h3>
    <p class="post-description">{description || remarkPluginFrontmatter.excerpt}</p>
    <div class="post-bottom"><div class="post-tags">{tags.slice(0,2).map(tag=><a href={getTagUrl(tag)}>#{tag}</a>)}</div><span class="reading-time">{remarkPluginFrontmatter.minutes || 1} 分钟</span><a class="post-arrow" href={postUrl} aria-label={`打开文章：${title}`}><svg viewBox="0 0 24 24" width="17" height="17" fill="none" stroke="currentColor" stroke-width="1.7" aria-hidden="true"><path d="M5 12h14m-5-5 5 5-5 5"/></svg></a></div>
  </div>
</article>
<style>
  .anime-post { background: var(--surface); border: 1px solid transparent; border-radius: 24px; box-shadow: var(--panel-shadow); transition: transform .2s, border-color .2s, box-shadow .2s; }
  .anime-post:focus-within { border-color: color-mix(in srgb,var(--accent) 30%,var(--line)); box-shadow: var(--panel-shadow-hover); }
  @media (hover: hover) and (pointer: fine) { .anime-post:hover { transform: translateY(-2px); border-color: color-mix(in srgb,var(--accent) 20%,var(--line)); box-shadow: var(--panel-shadow-hover); } }
  .post-copy { min-width: 0; padding: 26px; display: flex; flex-direction: column; }
  .post-meta { display: flex; flex-wrap: wrap; align-items: center; gap: 7px 13px; color: var(--muted); font-size: 11px; }
  .category-pill { padding: 2px 10px; font-size: 11px; border-radius: 8px; background: var(--soft); color: var(--accent); line-height: 1.8; }
  .category-pill:hover { background: color-mix(in srgb,var(--accent) 14%,var(--soft)); }
  .post-meta time { font-size: 11px; }
  .draft-badge { color: var(--accent); font-size: 10px; }
  h3 { font-size: 22px; font-weight: 650; line-height: 1.5; margin: 13px 0 10px; letter-spacing: -.02em; overflow-wrap: anywhere; }
  h3 a { display: -webkit-box; -webkit-line-clamp: 2; -webkit-box-orient: vertical; overflow: hidden; }
  h3 a:hover { color: var(--accent); }
  .post-title-text { background: linear-gradient(color-mix(in srgb,var(--accent) 65%,transparent),color-mix(in srgb,var(--accent) 65%,transparent)) 0 calc(100% - 1px)/0 1px no-repeat; -webkit-box-decoration-break: clone; box-decoration-break: clone; transition: background-size .25s ease; }
  .anime-post:focus-within .post-title-text { background-size: 100% 1px; }
  @media (hover: hover) and (pointer: fine) { .anime-post:hover .post-title-text { background-size: 100% 1px; } }
  .post-description { color: var(--muted); font-size: 14px; line-height: 1.8; margin: 0 0 17px; display: -webkit-box; -webkit-line-clamp: 2; -webkit-box-orient: vertical; overflow: hidden; }
  .post-bottom { display: flex; flex-wrap: wrap; align-items: center; gap: 5px 12px; margin-top: auto; font-size: 11px; color: var(--muted); }
  .post-tags { display: flex; flex-wrap: wrap; gap: 6px 10px; min-width: 0; overflow-wrap: anywhere; }
  .post-tags a { transition: color .2s; }
  .post-tags a:hover,.post-tags a:focus-visible { color: var(--accent); }
  .reading-time { white-space: nowrap; }
  .post-arrow { display: grid; place-items: center; color: var(--blue); margin-left: auto; width: 28px; height: 28px; border-radius: 10px; background: var(--soft); }
  .post-arrow { transition: color .2s,background .2s; }
  .post-arrow svg { transition: transform .22s ease; }
  .anime-post:focus-within .post-arrow { color: var(--accent); background: color-mix(in srgb,var(--accent) 13%,var(--soft)); }
  .anime-post:focus-within .post-arrow svg { transform: translateX(3px); }
  @media (hover: hover) and (pointer: fine) { .anime-post:hover .post-arrow { color: var(--accent); background: color-mix(in srgb,var(--accent) 13%,var(--soft)); } .anime-post:hover .post-arrow svg { transform: translateX(3px); } }
  @media (max-width: 1000px) { .post-copy { padding: 24px; } h3 { font-size: 21px; } }
  @media (max-width: 760px) { .post-copy { padding: 22px; } }
  @media (max-width: 480px) { .anime-post { border-radius: 22px; } h3 { font-size: 20px; margin: 12px 0 8px; } .post-description { margin-bottom: 15px; } .post-meta { gap: 7px 10px; } .category-pill { padding: 2px 8px; } .post-tags { gap: 6px 8px; } }
  @media (prefers-reduced-motion: reduce) { .anime-post,.post-arrow,.post-arrow svg,.post-title-text { transform: none !important; transition: none; } }
</style>
