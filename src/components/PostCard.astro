---
import type { CollectionEntry } from "astro:content";
import PostCover from "./PostCover.astro";
import { getPostUrlBySlug, getCategoryUrl } from "@utils/url-utils";
interface Props { entry: CollectionEntry<"posts">; index?: number; }
const { entry } = Astro.props;
const { title, category, description, tags, published } = entry.data;
const { remarkPluginFrontmatter } = await entry.render();
const date = published.toISOString().slice(0,10);
const postUrl = getPostUrlBySlug(entry.slug);
---
<article class="anime-post">
  <a class="post-cover-link" href={postUrl} aria-label={`阅读：${title}`}><PostCover entry={entry} /></a>
  <div class="post-copy">
    <div class="post-meta"><a class="category-pill" href={getCategoryUrl(category)}>{category || "随记"}</a><time datetime={date}>{date.replaceAll("-", ".")}</time>{entry.data.draft && <span class="draft-badge">草稿</span>}</div>
    <h3><a href={postUrl}>{title}</a></h3>
    <p class="post-description">{description || remarkPluginFrontmatter.excerpt}</p>
    <div class="post-bottom"><div class="post-tags">{tags.slice(0,2).map(tag=><span>#{tag}</span>)}</div><span class="reading-time">{remarkPluginFrontmatter.minutes || 1} 分钟</span><a class="post-arrow" href={postUrl} aria-label={`打开文章：${title}`}><svg viewBox="0 0 24 24" width="17" height="17" fill="none" stroke="currentColor" stroke-width="1.7" aria-hidden="true"><path d="M5 12h14m-5-5 5 5-5 5"/></svg></a></div>
  </div>
</article>
<style>
  .anime-post { display:grid;grid-template-columns:176px minmax(0,1fr);background: var(--surface); border: 1px solid var(--line); border-radius: 16px; overflow: hidden; box-shadow: var(--panel-shadow); transition: transform .2s, border-color .2s, box-shadow .2s; }
  .anime-post:hover { transform: translateY(-3px); border-color: color-mix(in srgb,var(--accent) 48%,var(--line)); box-shadow:0 12px 28px #080d1726,0 0 12px #38bdf81f; }
  .post-cover-link { display:block;min-height:170px;overflow:hidden; }
  .post-copy { min-width: 0; padding: 23px 27px 19px; display: flex; flex-direction: column; }
  .post-meta { display: flex; align-items: center; gap: 13px; color: var(--muted); font-size: 11px; }
  .category-pill { padding: 2px 10px; font-size: 10px; border-radius: 7px; background: color-mix(in srgb,var(--accent) 11%,transparent); color: var(--accent); line-height: 1.8; }
  .category-pill:hover { background: color-mix(in srgb,var(--accent) 22%,transparent); }
  .post-meta time { font-size: 11px; }
  .draft-badge { color: var(--accent); font-size: 10px; }
  h3 { font-size: 21px; font-weight: 600; line-height: 1.55; margin: 11px 0 9px; letter-spacing: -.02em; }
  h3 a { display: -webkit-box; -webkit-line-clamp: 2; -webkit-box-orient: vertical; overflow: hidden; }
  h3 a:hover { color: var(--accent); }
  .post-description { color: var(--muted); font-size: 13px; line-height: 1.85; margin: 0 0 17px; display: -webkit-box; -webkit-line-clamp: 2; -webkit-box-orient: vertical; overflow: hidden; }
  .post-bottom { display: flex; flex-wrap: wrap; align-items: center; gap: 5px 12px; margin-top: auto; font-size: 10px; color: var(--muted); }
  .post-tags { display: flex; flex-wrap: wrap; gap: 10px; min-width: 0; }
  .reading-time { white-space: nowrap; }
  .post-arrow { display: grid; place-items: center; color: var(--blue); margin-left: auto; width: 26px; height: 26px; border-radius: 50%; background: var(--soft); }
  .post-arrow:hover { color: var(--accent); }
  @media (max-width: 1000px) { .post-copy { padding: 19px 20px 15px; } h3 { font-size: 19px; } .post-description { font-size: 12px; } }
  @media (max-width: 760px) { h3 { font-size: 20px; } .post-description { -webkit-line-clamp: 2; } }
  @media (max-width: 600px) { .anime-post { grid-template-columns:100px minmax(0,1fr); } .post-cover-link { min-height:150px; } }
  @media (max-width: 480px) { .anime-post { border-radius: 14px; } .post-copy { padding: 19px 20px 15px; } h3 { font-size: 19px; margin: 10px 0; } .post-description { font-size: 12px; margin-bottom: 14px; } .post-meta { gap: 10px; } .post-meta time { font-size: 10px; } .category-pill { padding: 2px 8px; font-size: 10px; } .post-tags { gap: 8px; font-size: 9px; } .post-bottom { font-size: 10px; } .post-arrow { width: 25px; height: 25px; } }
</style>
