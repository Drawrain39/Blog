---
import { getSortedPosts } from "../utils/content-utils";

const posts = await getSortedPosts();
const today = new Intl.DateTimeFormat("en-CA", { timeZone: "Asia/Shanghai", year: "numeric", month: "2-digit", day: "2-digit" }).format(new Date());
const end = new Date(`${today}T00:00:00Z`);
const rangeStart = new Date(end);
rangeStart.setUTCDate(end.getUTCDate() - 364);
const start = new Date(rangeStart);
start.setUTCDate(rangeStart.getUTCDate() - rangeStart.getUTCDay());
const counts = new Map<string, number>();
for (const post of posts) {
  const key = post.data.published.toISOString().slice(0, 10);
  counts.set(key, (counts.get(key) || 0) + 1);
}
const days = Array.from({ length: 371 }, (_, index) => {
  const date = new Date(start);
  date.setUTCDate(start.getUTCDate() + index);
  const key = date.toISOString().slice(0, 10);
  const count = counts.get(key) || 0;
  const future = date > end;
  const outside = date < rangeStart;
  const dateLabel = `${date.getUTCFullYear()}年${date.getUTCMonth() + 1}月${date.getUTCDate()}日`;
  return { index, key, count, future, outside, month: date.getUTCMonth() + 1, day: date.getUTCDate(), label: `${dateLabel} · ${future ? `未来日期，已安排${count}篇文章` : `撰写了${count}篇文章`}${outside ? "（统计期外）" : ""}` };
});
const total = days.filter((day) => !day.future && !day.outside).reduce((sum, day) => sum + day.count, 0);
const monthStarts = days.filter((day) => day.index === 0 || day.day === 1).map((day) => ({ month: day.month, column: Math.floor(day.index / 7) + 1 }));
const months = monthStarts.filter((month, index) => index === monthStarts.length - 1 || monthStarts[index + 1].column - month.column >= 3);
---

<activity-calendar-widget>
  <section class="activity-calendar" aria-labelledby="activity-title">
    <header><h2 id="activity-title">写作日历</h2><span>近一年 · <strong>{total}</strong> 篇文章</span></header>
    <p id="activity-help" class="sr-only">按真实发布日期统计。使用方向键查看相邻日期，Home 和 End 查看统计期首尾；每个日期会显示当天发表的记录数。</p>
    <div class="activity-scroll">
      <div class="calendar-content">
        <div class="activity-months" aria-hidden="true">{months.map((month) => <span style={`grid-column: ${month.column}`}>{month.month}月</span>)}</div>
        <div class="calendar-grid">
          <div class="weekday-labels" aria-hidden="true"><span>一</span><span>三</span><span>五</span></div>
          <div class="activity-cells" role="group" aria-label={`近一年共发布 ${total} 篇文章的写作日历`} aria-describedby="activity-help">
            {days.map((day) => <button type="button" class="activity-day" data-index={day.index} data-tooltip={day.label} data-level={day.future || day.outside ? "outside" : Math.min(day.count, 3)} tabindex={day.key === today ? 0 : -1} aria-label={day.label} aria-describedby="activity-day-tooltip" aria-current={day.key === today ? "date" : undefined}></button>)}
          </div>
        </div>
      </div>
    </div>
    <footer><span>按本站文章的真实发布日期统计。</span><span class="activity-legend" aria-label="颜色越亮，发表记录越多">少 <i data-level="0"></i><i data-level="1"></i><i data-level="2"></i><i data-level="3"></i> 多</span></footer>
    <div id="activity-day-tooltip" class="activity-tooltip" role="tooltip" popover="manual" hidden></div>
  </section>
</activity-calendar-widget>

<style>
  activity-calendar-widget { display: block; min-width: 0; }
  .activity-calendar { --activity-empty: color-mix(in srgb, var(--muted) 10%, var(--surface)); --activity-1: #bddcf2; --activity-2: color-mix(in srgb, var(--accent) 60%, #45d7ed); --activity-3: color-mix(in srgb, var(--accent) 15%, #238bff); margin-top: 20px; padding: 20px; background: var(--surface); border: 1px solid var(--line); border-radius: 18px; min-width: 0; }
  :global(.dark) .activity-calendar { --activity-empty: #293447; --activity-1: #5b8bad; --activity-2: color-mix(in srgb, var(--accent) 80%, #43d5f3); --activity-3: #278eff; }
  header { display: flex; align-items: center; justify-content: space-between; gap: 12px; margin-bottom: 14px; }
  h2 { font-size: 19px; font-weight: 650; }
  header > span, footer { font-size: 12px; color: var(--muted); }
  header strong { font-weight: 750; color: var(--accent); }
  .activity-scroll { max-width: 100%; min-width: 0; overflow-x: auto; overscroll-behavior-x: contain; padding: 4px 2px 7px; scrollbar-width: thin; scrollbar-color: var(--line) transparent; }
  .calendar-content { min-width: 780px; }
  .activity-months { display: grid; grid-template-columns: repeat(53, minmax(10px, 1fr)); column-gap: 4px; height: 16px; margin: 0 0 7px 28px; font-size: 10px; color: var(--muted); }
  .activity-months span { white-space: nowrap; }
  .calendar-grid { display: grid; grid-template-columns: 20px minmax(0, 1fr); gap: 8px; }
  .weekday-labels { display: grid; grid-template-rows: repeat(7, 12px); gap: 4px; font-size: 9px; line-height: 12px; color: var(--muted); }
  .weekday-labels span:nth-child(1) { grid-row: 2; }
  .weekday-labels span:nth-child(2) { grid-row: 4; }
  .weekday-labels span:nth-child(3) { grid-row: 6; }
  .activity-cells { display: grid; grid-template-rows: repeat(7, 12px); grid-template-columns: repeat(53, minmax(10px, 1fr)); grid-auto-flow: column; gap: 4px; }
  .activity-day, .activity-legend i { display: block; border-radius: 3px; background: var(--activity-empty); border: 1px solid color-mix(in srgb, var(--muted) 18%, transparent); }
  .activity-day { min-width: 0; width: 100%; height: 12px; margin: 0; padding: 0; cursor: pointer; transition: border-color .15s, filter .15s, box-shadow .15s; }
  .activity-day[data-level="1"], .activity-legend i[data-level="1"] { background: var(--activity-1); border-color: color-mix(in srgb, var(--activity-1) 75%, var(--accent)); }
  .activity-day[data-level="2"], .activity-legend i[data-level="2"] { background: var(--activity-2); border-color: var(--activity-2); }
  .activity-day[data-level="3"], .activity-legend i[data-level="3"] { background: var(--activity-3); border-color: var(--activity-3); }
  [data-level="outside"] { opacity: .3; }
  .activity-day:hover, .activity-day:focus-visible { position: relative; z-index: 1; filter: brightness(1.16); border-color: var(--accent); outline: 2px solid var(--accent); outline-offset: 2px; }
  footer { margin-top: 10px; display: flex; justify-content: space-between; flex-wrap: wrap; gap: 10px; }
  .activity-legend { display: flex; gap: 5px; align-items: center; }
  .activity-legend i { width: 11px; height: 11px; }
  .activity-tooltip { position: fixed; inset: auto; width: max-content; max-width: calc(100vw - 24px); margin: 0; padding: 9px 12px; border: 1px solid color-mix(in srgb, var(--accent) 28%, var(--line)); border-radius: 9px; background: var(--surface); color: var(--ink); box-shadow: 0 6px 24px #080d1738; font-size: 11px; line-height: 1.6; pointer-events: none; z-index: 300; }
  .sr-only { position: absolute; width: 1px; height: 1px; padding: 0; margin: -1px; overflow: hidden; clip: rect(0,0,0,0); white-space: nowrap; border: 0; }
  @media (max-width: 600px) { .activity-calendar { padding: 16px; } header { align-items: flex-start; flex-wrap: wrap; gap: 6px; margin-bottom: 12px; } header > span, footer { font-size: 11px; } h2 { font-size: 18px; } .calendar-content { min-width: 750px; } }
</style>

<script>
  class ActivityCalendar extends HTMLElement {
    private controller?: AbortController;

    connectedCallback() {
      this.controller?.abort();
      this.controller = new AbortController();
      const { signal } = this.controller;
      const cells = Array.from(this.querySelectorAll<HTMLButtonElement>(".activity-day"));
      const tooltip = this.querySelector<HTMLElement>(".activity-tooltip")!;
      const scroller = this.querySelector<HTMLElement>(".activity-scroll")!;
      let hovered: HTMLButtonElement | null = null;
      let visibleTarget: HTMLButtonElement | null = null;
      const getCell = (target: EventTarget | null) => target instanceof Element ? target.closest<HTMLButtonElement>(".activity-day") : null;

      const hide = () => {
        if (typeof tooltip.hidePopover === "function" && tooltip.matches(":popover-open")) tooltip.hidePopover();
        tooltip.hidden = true;
        visibleTarget = null;
      };
      const position = () => {
        if (!visibleTarget?.isConnected) { hide(); return; }
        const bounds = visibleTarget.getBoundingClientRect();
        const scrollBounds = scroller.getBoundingClientRect();
        if (bounds.right < scrollBounds.left || bounds.left > scrollBounds.right || bounds.bottom < 0 || bounds.top > window.innerHeight) { hide(); return; }
        const size = tooltip.getBoundingClientRect();
        const left = Math.max(12, Math.min(bounds.left + bounds.width / 2 - size.width / 2, window.innerWidth - size.width - 12));
        const top = bounds.top - size.height - 9 >= 8 ? bounds.top - size.height - 9 : Math.min(bounds.bottom + 9, window.innerHeight - size.height - 8);
        tooltip.style.left = `${left}px`;
        tooltip.style.top = `${Math.max(8, top)}px`;
      };
      const show = (cell: HTMLButtonElement) => {
        visibleTarget = cell;
        tooltip.textContent = cell.dataset.tooltip || "";
        tooltip.hidden = false;
        if (typeof tooltip.showPopover === "function" && !tooltip.matches(":popover-open")) tooltip.showPopover();
        position();
      };

      this.addEventListener("pointerover", (event) => {
        hovered = getCell(event.target);
        if (hovered) show(hovered);
        else { const focused = getCell(document.activeElement); if (focused && this.contains(focused)) show(focused); else hide(); }
      }, { signal });
      this.addEventListener("pointerleave", () => { hovered = null; const focused = getCell(document.activeElement); if (focused && this.contains(focused)) show(focused); else hide(); }, { signal });
      this.addEventListener("focusin", (event) => {
        const cell = getCell(event.target);
        if (!cell) return;
        for (const day of cells) day.tabIndex = day === cell ? 0 : -1;
        show(cell);
      }, { signal });
      this.addEventListener("focusout", () => queueMicrotask(() => { const focused = getCell(document.activeElement); if (focused && this.contains(focused)) show(focused); else if (hovered) show(hovered); else hide(); }), { signal });
      this.addEventListener("keydown", (event) => {
        const cell = getCell(event.target);
        if (!cell) return;
        if (event.key === "Escape") { hide(); return; }
        const index = Number(cell.dataset.index);
        const step: Record<string, number> = { ArrowLeft: -7, ArrowRight: 7, ArrowUp: -1, ArrowDown: 1 };
        if (!(event.key in step) && event.key !== "Home" && event.key !== "End") return;
        event.preventDefault();
        const next = event.key === "Home" ? cells.findIndex((day) => day.dataset.level !== "outside") : event.key === "End" ? cells.findIndex((day) => day.getAttribute("aria-current") === "date") : Math.max(0, Math.min(cells.length - 1, index + step[event.key]));
        if (next < 0) return;
        cells[next].focus({ preventScroll: true });
        cells[next].scrollIntoView({ block: "nearest", inline: "nearest" });
        show(cells[next]);
      }, { signal });
      document.addEventListener("pointerdown", (event) => { if (event.target instanceof Node && !this.contains(event.target)) hide(); }, { signal });
      scroller.addEventListener("scroll", position, { signal, passive: true });
      window.addEventListener("resize", position, { signal, passive: true });
      window.addEventListener("scroll", position, { signal, passive: true });
      document.addEventListener("astro:before-swap", hide, { signal });
    }

    disconnectedCallback() { this.controller?.abort(); }
  }
  if (!customElements.get("activity-calendar-widget")) customElements.define("activity-calendar-widget", ActivityCalendar);
</script>
