---
import type { CollectionEntry } from "astro:content";
import PostCard from "./PostCard.astro";
interface Props { posts: CollectionEntry<"posts">[]; }
const { posts } = Astro.props;
const filters = [
  { name: "全部文章", value: "all" },
  { name: "CTF", value: "ctf" },
  { name: "AI / Agent", value: "ai" },
  { name: "学习笔记", value: "study" },
  { name: "折腾博客", value: "journal" },
];
function group(category: string | null) {
  if (category === "CTF") return "ctf";
  if (category === "AI") return "ai";
  if (["blog", "markdown"].includes(category || "")) return "journal";
  return "study";
}
---
<div class="post-browser" data-post-browser>
  <div class="post-filters" role="group" aria-label="筛选文章分类">
    {filters.map(filter => <button type="button" data-filter={filter.value} aria-pressed={filter.value === "all"}>{filter.name}<span>{posts.filter(post=>filter.value === "all" || group(post.data.category) === filter.value).length}</span></button>)}
  </div>
  <div class="post-entries" aria-live="polite">
    {posts.map((entry,index) => <div class="post-entry" data-group={group(entry.data.category)}><PostCard entry={entry} index={index} /></div>)}
  </div>
  <p class="empty-entries" hidden>这个主题还没有记录，先看看其他文章吧。</p>
  <div class="feed-bottom"><span data-post-count>共 {posts.length} 篇文章</span><button type="button" class="load-more" hidden>加载更多 <span aria-hidden="true">↓</span></button><span class="feed-end" hidden>已经到底啦 <span aria-hidden="true">✧</span></span></div>
</div>
<script>
function initializePostBrowsers() {
  document.querySelectorAll<HTMLElement>("[data-post-browser]").forEach(browser => {
    if(browser.dataset.bound) return;
    browser.dataset.bound="true";
    const entries = Array.from(browser.querySelectorAll<HTMLElement>(".post-entry"));
    const buttons = browser.querySelectorAll<HTMLButtonElement>("[data-filter]");
    const loadMore = browser.querySelector<HTMLButtonElement>(".load-more");
    const count = browser.querySelector<HTMLElement>("[data-post-count]");
    const end = browser.querySelector<HTMLElement>(".feed-end");
    const empty = browser.querySelector<HTMLElement>(".empty-entries");
    let active = "all";
    let limit = 6;
    function update() {
      const matching = entries.filter(entry => active === "all" || entry.dataset.group === active);
      entries.forEach(entry => entry.hidden = true);
      matching.slice(0,limit).forEach(entry => entry.hidden = false);
      buttons.forEach(button => button.setAttribute("aria-pressed", String(button.dataset.filter === active)));
      if (count) count.textContent = `已展示 ${Math.min(limit, matching.length)} / ${matching.length} 篇记录`;
      if (loadMore) loadMore.hidden = matching.length <= limit;
      if (end) end.hidden = matching.length > limit || matching.length === 0;
      if (empty) empty.hidden = matching.length !== 0;
    }
    buttons.forEach(button => button.addEventListener("click",()=>{ active = button.dataset.filter || "all"; limit = 6; update(); }));
    loadMore?.addEventListener("click",()=>{ limit += 6; update(); });
    update();
  });
}
initializePostBrowsers();
document.addEventListener("astro:page-load",initializePostBrowsers);
</script>
<style>
  .post-filters { display: flex; flex-wrap: wrap; align-items: center; gap: 6px; padding: 8px; background: var(--surface); border: 1px solid var(--line); border-radius: 14px; margin-bottom: 20px; }
  .post-filters button { border: 1px solid transparent; border-radius: 9px; background: transparent; padding: 7px 13px; font-size: 12px; color: var(--muted); transition: color .2s, background .2s; }
  .post-filters button span { margin-left: 7px; font-size: 9px; opacity: .65; }
  .post-filters button[aria-pressed="true"] { background: color-mix(in srgb,var(--accent) 15%,transparent); color: var(--accent); }
  .post-filters button:hover { border-color: var(--line); }
  .post-filters button[aria-pressed="false"]:hover { color: var(--accent); }
  .post-entries { display: flex; flex-direction: column; gap: 19px; }
  .feed-bottom { display: flex; justify-content: space-between; align-items: center; gap: 12px; padding: 25px 2px 10px; font-size: 11px; color: var(--muted); }
  .load-more { display: inline-flex; align-items: center; gap: 20px; padding: 9px 17px; border: 1px solid var(--line); border-radius: 10px; background: var(--surface); font-size: 12px; color: var(--ink); }
  .load-more:hover { border-color: var(--accent); color: var(--accent); }
  .feed-end { font-size: 11px; }
  .feed-end span { color: var(--accent); margin-left: 7px; }
  .empty-entries { padding: 35px 0; color: var(--muted); font-size: 13px; }
  @media (max-width: 480px) { .post-filters { gap: 3px; padding: 7px; } .post-filters button { padding: 6px 8px; font-size: 11px; } .post-filters button span { margin-left: 4px; font-size: 8px; } .post-entries { gap: 14px; } }
</style>
