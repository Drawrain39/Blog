---
import FriendLinkCard from "@components/FriendLinkCard.astro";
import ImageWrapper from "@components/misc/ImageWrapper.astro";
import { friendLinks } from "../constants/friends";
import MainGridLayout from "../layouts/MainGridLayout.astro";
import CopyButton from "../components/CopyButton.astro";
const siteInfo = `站名：Drawrain's Blog\n网址：https://drawrain.me/\n头像：https://drawrain.me/images/avatar.webp\n简介：Just keep drawing without regrets.\n邮箱：858617595@qq.com`;
---

<MainGridLayout title="友情链接" description="Drawrain 的友情链接，欢迎互换友链。">
	<div class="friends-page">
		<header class="friends-cover"><ImageWrapper src="assets/images/tam.png" alt="幻想风格的角色插画" class="cover-art" /><div class="cover-shade"></div><div class="cover-copy"><span class="page-location">首页 / 友链</span><h1>友情链接<span aria-hidden="true"> ✧</span></h1><p>欢迎找我互换友链！QQ：858617595</p></div></header>
		<div class="friends-heading"><h2>我的朋友们</h2><span>{friendLinks.length} 位朋友</span></div>
		<section class="friend-grid" aria-label="友情链接">{friendLinks.map((friend) => <FriendLinkCard friend={friend} />)}</section>
		<section class="exchange-card" aria-labelledby="exchange-title"><div class="exchange-rules"><h2 id="exchange-title"><span aria-hidden="true">✉</span> 申请友链</h2><ul><li>站点需可正常访问而且在更新即可</li><li>内容不限，看到了就会加上</li><li>记得给我个介绍即可（最好）</li></ul><a href="mailto:858617595@qq.com" class="exchange-contact">QQ · 858617595 <span>↗</span></a></div><div class="site-details"><div class="site-details-heading"><h3>我的站点信息</h3><CopyButton text={siteInfo} label="复制本站信息" variant="ghost" /></div><dl><dt>站名</dt><dd>Drawrain's Blog</dd><dt>介绍</dt><dd>Just keep drawing without regrets.</dd><dt>邮箱</dt><dd><a href="mailto:858617595@qq.com">858617595@qq.com</a></dd></dl></div></section>
	</div>
</MainGridLayout>

<style>
	.friends-page { padding-top: 30px; }
	.friends-cover { position: relative; min-height: 245px; overflow: hidden; border-radius: 24px; border: 1px solid var(--line); background: var(--surface); }
	.friends-cover :global(.cover-art) { position: absolute; inset: 0; height: 100%; }
	.friends-cover :global(.cover-art img) { object-position: center 42%; }
	.cover-shade { position: absolute; inset: 0; background: linear-gradient(90deg, color-mix(in srgb, var(--surface) 96%, transparent), color-mix(in srgb, var(--surface) 15%, transparent) 95%), linear-gradient(0deg, var(--surface), transparent 90%); }
	.cover-copy { position: relative; padding: 38px; }
	.page-location { color: var(--muted); font-size: 11px; }
	.cover-copy h1 { font-size: 38px; font-weight: 700; margin: 23px 0 10px; color: var(--ink); }
	.cover-copy h1 span { color: var(--accent); font-size: 25px; vertical-align: middle; }
	.cover-copy p { color: var(--muted); font-size: 13px; }
	.friends-heading { display: flex; align-items: center; justify-content: space-between; gap: 20px; margin: 32px 2px 18px; }
	.friends-heading h2 { font-size: 19px; font-weight: 600; }
	.friends-heading > span { font-size: 11px; color: var(--muted); }
	.friend-grid { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 20px; }
	.exchange-card { display: grid; grid-template-columns: 1fr 1fr; gap: 50px; background: var(--surface); border: 1px solid var(--line); border-radius: 20px; padding: 32px; margin-top: 28px; }
	.exchange-rules h2 { margin: 0 0 19px; font-size: 19px; font-weight: 600; }
	.exchange-rules h2 > span { margin-right: 7px; color: var(--accent); }
	.exchange-rules ul { list-style: disc; padding-left: 20px; font-size: 13px; color: var(--muted); line-height: 2.1; }
	.exchange-contact { display: inline-flex; align-items: center; gap: 40px; padding: 10px 18px; border: 1px solid var(--line); border-radius: 12px; background: var(--soft); color: var(--accent); margin-top: 19px; font-size: 13px; }
	.exchange-contact:hover { border-color: var(--accent); }
	.site-details { min-width:0; border-left: 1px solid var(--line); padding-left: 40px; }
	.site-details-heading { display:flex;align-items:center;justify-content:space-between;gap:10px;margin-bottom:23px; }
	.site-details-heading :global(copy-button) { flex-shrink:0; }
	.site-details h3 { font-size: 15px; margin:0; font-weight: 600; }
	.site-details dl { display: grid; grid-template-columns: 40px minmax(0, 1fr); gap: 17px; font-size: 12px; }
	.site-details dt { color: var(--muted); }
	.site-details dd { margin: 0; overflow-wrap: anywhere; }
	.site-details a:hover { color: var(--accent); }
	@media (max-width: 950px) { .friend-grid { grid-template-columns: repeat(2, minmax(0, 1fr)); } .exchange-card { gap: 25px; } .site-details { padding-left: 25px; } }
	@media (max-width: 600px) { .friends-page { padding-top: 20px; } .friends-cover { min-height: 225px; border-radius: 18px; } .cover-copy { padding: 25px; } .cover-copy h1 { font-size: 32px; } .cover-copy p { max-width: 220px; line-height: 1.9; } .friend-grid { grid-template-columns: 1fr; gap: 15px; } .exchange-card { grid-template-columns: 1fr; gap: 25px; padding: 25px; } .site-details { border-left: 0; border-top: 1px solid var(--line); padding: 25px 0 0; } .site-details h3 { font-size:14px; } }
</style>
