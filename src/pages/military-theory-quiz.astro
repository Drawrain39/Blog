---
import MilitaryTheoryQuizApp from "@components/MilitaryTheoryQuiz.svelte";
import Navbar from "@components/Navbar.astro";
import Footer from "@components/Footer.astro";
import Layout from "@layouts/Layout.astro";
import type { MilitaryTheoryData } from "@utils/military-theory-quiz";
import { url } from "@utils/url-utils";
import militaryTheoryQuizData from "../data/military-theory-quiz.json";
import "../styles/study.css";

const quizData = militaryTheoryQuizData as MilitaryTheoryData;
---

<Layout title="军事理论刷题模式" description="军事理论期末复习刷题页面，覆盖选择、填空、判断、简答、论述和知识点复习。" bodyClass="study-page military-study-page">
	<Navbar />
	<main id="main-content" class="study-workspace site-container" tabindex="-1">
		<nav class="study-trail" aria-label="刷题页面导航"><span>STUDY NOTES / MILITARY THEORY</span><div><a href={url("/posts/military-theory/")}>← 复习原文</a><a href={url("/archive/")}>全部文章 ↗</a></div></nav>
		<MilitaryTheoryQuizApp data={quizData} client:load />
	</main>
	<div class="site-container"><Footer /></div>
</Layout>
