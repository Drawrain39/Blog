---
import path from "node:path";
import type { CollectionEntry } from "astro:content";
import License from "@components/misc/License.astro";
import Markdown from "@components/misc/Markdown.astro";
import ImageWrapper from "@components/misc/ImageWrapper.astro";
import MainGridLayout from "@layouts/MainGridLayout.astro";
import { getSeriesPostsForEntry, getSortedPosts, type SeriesPost } from "@utils/content-utils";
import { getCategoryUrl, getDir, getPostUrlBySlug, getTagUrl, url } from "@utils/url-utils";
import { licenseConfig, profileConfig, siteConfig } from "@/config";
import "../../styles/editorial-article.css";

export async function getStaticPaths() {
	const blogEntries = await getSortedPosts();
	return blogEntries.map((entry) => ({
		params: { slug: entry.slug },
		props: { entry, seriesPosts: getSeriesPostsForEntry(entry, blogEntries) },
	}));
}

interface Props {
	entry: CollectionEntry<"posts">;
	seriesPosts: SeriesPost[];
}

const { entry, seriesPosts = [] } = Astro.props;
const { Content, headings, remarkPluginFrontmatter } = await entry.render();
const contents = headings.filter((heading) => heading.depth <= siteConfig.toc.depth).map((heading) => ({ ...heading, text: heading.text.replace(/#$/, "").trim() }));
const showContents = siteConfig.toc.enable && contents.length > 0;
const hasSeries = entry.data.series && seriesPosts.length > 1;
const dateLabel = (date: Date) => date.toISOString().slice(0, 10).replaceAll("-", ".");
const minutes = Math.max(1, Math.round(Number(remarkPluginFrontmatter.minutes) || 1));
const words = Number(remarkPluginFrontmatter.words) || 0;

const jsonLd = {
	"@context": "https://schema.org",
	"@type": "BlogPosting",
	headline: entry.data.title,
	description: entry.data.description || entry.data.title,
	keywords: entry.data.tags,
	author: { "@type": "Person", name: profileConfig.name, url: Astro.site },
	datePublished: entry.data.published.toISOString(),
	...(entry.data.updated ? { dateModified: entry.data.updated.toISOString() } : {}),
	inLanguage: (entry.data.lang || siteConfig.lang).replace("_", "-"),
	...(entry.data.series ? { isPartOf: { "@type": "CreativeWorkSeries", name: entry.data.series } } : {}),
};
---

<MainGridLayout
	banner={entry.data.image}
	title={entry.data.title}
	description={entry.data.description}
	lang={entry.data.lang}
	setOGTypeArticle={true}
	headings={headings}
	articleLayout={true}
>
	<script is:inline slot="head" type="application/ld+json" set:html={JSON.stringify(jsonLd).replace(/</g, "\\u003c")}></script>
	<div class="reading-progress" aria-hidden="true"><span id="reading-progress-fill"></span></div>
	<div class="editorial-article">
		<nav class="article-breadcrumb" aria-label="面包屑导航" data-pagefind-ignore>
			<a href={url("/")}>首页</a><span>/</span><a href={url("/archive/")}>文章</a>
			{entry.data.category && <><span>/</span><a href={getCategoryUrl(entry.data.category)}>{entry.data.category}</a></>}
		</nav>

		<div class:list={["article-reading-grid", { "without-contents": !showContents }]}>
			<article id="post-container" class="article-body-column">
				<header class="article-header">
					<a class="article-category" href={getCategoryUrl(entry.data.category)}><span aria-hidden="true">✦</span>{entry.data.category || "随手记录"}</a>
					<h1 data-pagefind-body data-pagefind-weight="10" data-pagefind-meta="title">{entry.data.title}</h1>
					{entry.data.description && <p class="article-deck">{entry.data.description}</p>}
					<div class="article-byline" data-pagefind-ignore>
						<a href={url("/about/")} class="article-author"><ImageWrapper src={profileConfig.avatar || "assets/images/avata.jpg"} alt="" class="article-author-avatar" />{profileConfig.name}</a>
						<span class="article-meta-dot">·</span>
						<time datetime={entry.data.published.toISOString()}>{dateLabel(entry.data.published)}</time>
						<span class="article-meta-dot">·</span><span>约 {minutes} 分钟</span>
						<span class="article-word-count">{words.toLocaleString("zh-CN")} 字</span>
					</div>
					{entry.data.updated && entry.data.updated.getTime() > entry.data.published.getTime() && <p class="article-updated">更新于 <time datetime={entry.data.updated.toISOString()}>{dateLabel(entry.data.updated)}</time></p>}
				</header>
				<div class="article-reading-content">
				{showContents && <details class="article-mobile-contents" data-pagefind-ignore>
					<summary><span>本文目录</span><span>{contents.length} 个章节 <span aria-hidden="true">＋</span></span></summary>
					<nav aria-label="本文目录"><ol>{contents.map((heading) => <li class:list={{ "contents-subsection": heading.depth > 1 }}><a href={`#${heading.slug}`}>{heading.text}</a></li>)}</ol></nav>
				</details>}
				{entry.data.image && <ImageWrapper id="post-cover" src={entry.data.image} basePath={path.join("content/posts/", getDir(entry.id))} alt={entry.data.title} class="article-cover" />}
				<Markdown class="article-prose"><Content /></Markdown>
				<div class="article-end-mark" aria-hidden="true"><span></span>✦<span></span></div>

				{hasSeries && <section class="article-series" aria-label="文章系列" data-pagefind-ignore>
					<p class="article-small-label">继续阅读这个系列</p><h2>{entry.data.series}</h2>
					<ol>{seriesPosts.map((post, index) => <li><a href={getPostUrlBySlug(post.slug)} aria-current={post.slug === entry.slug ? "page" : undefined}><span class="series-number">{String(post.seriesOrder ?? index + 1).padStart(2, "0")}</span><span>{post.title}</span>{post.slug === entry.slug && <span class="series-current">正在阅读</span>}</a></li>)}</ol>
				</section>}
				{licenseConfig.enable && <License title={entry.data.title} slug={entry.slug} pubDate={entry.data.published} class="article-license" />}

				<footer class="article-colophon" data-pagefind-ignore>
					<div class="article-tags">{entry.data.tags.map((tag) => <a href={getTagUrl(tag)}>#{tag}</a>)}</div>
					<button type="button" id="copy-article-link" class="article-copy-link"><span aria-hidden="true">↗</span> 复制文章链接</button>
					<span id="article-copy-status" class="sr-only" role="status" aria-live="polite"></span>
				</footer>

				<nav class="article-pagination" aria-label="相邻文章" data-pagefind-ignore>
					{entry.data.nextSlug ? <a href={getPostUrlBySlug(entry.data.nextSlug)}><span class="article-small-label">← 较新一篇</span><strong>{entry.data.nextTitle}</strong></a> : <span></span>}
					{entry.data.prevSlug && <a href={getPostUrlBySlug(entry.data.prevSlug)} class="article-next"><span class="article-small-label">较早一篇 →</span><strong>{entry.data.prevTitle}</strong></a>}
				</nav>
				</div>
			</article>

			{showContents && <aside class="article-sidebar" data-pagefind-ignore>
				<div class="article-sidebar-sticky">
					<h2><span class="article-toc-icon" aria-hidden="true">☷</span>本文目录<span class="article-toc-count">{contents.length}</span></h2>
					<nav aria-label="文章章节"><ol>{contents.map((heading) => <li class:list={{ "contents-subsection": heading.depth > 1 }}><a data-article-heading={heading.slug} href={`#${heading.slug}`}>{heading.text}</a></li>)}</ol></nav>
					<a href="#" class="article-back-top">回到顶部 <span aria-hidden="true">↑</span></a>
				</div>
			</aside>}
		</div>
	</div>
</MainGridLayout>

<script>
	let articleController: AbortController | undefined;
	function initializeArticle() {
	articleController?.abort();
	articleController = new AbortController();
	const { signal } = articleController;
	const progress = document.getElementById("reading-progress-fill");
	const article = document.getElementById("post-container");
	const tocLinks = [...document.querySelectorAll<HTMLAnchorElement>("[data-article-heading]")];
	const sections = tocLinks.map((link) => ({ link, heading: document.getElementById(link.dataset.articleHeading || "") }));
	let scrollQueued = false;
	function updateReadingPosition() {
		scrollQueued = false;
		if (!article) return;
		const bounds = article.getBoundingClientRect();
		const total = Math.max(1, bounds.height - window.innerHeight);
		const ratio = Math.max(0, Math.min(1, -bounds.top / total));
		if (progress) progress.style.transform = `scaleX(${ratio})`;
		let current = sections[0]?.link;
		for (const section of sections) {
			if (section.heading && section.heading.getBoundingClientRect().top < 170) current = section.link;
		}
		for (const { link } of sections) {
			if (link === current) link.setAttribute("aria-current", "location");
			else link.removeAttribute("aria-current");
		}
	}
	window.addEventListener("scroll", () => {
		if (!scrollQueued) { scrollQueued = true; requestAnimationFrame(updateReadingPosition); }
	}, { passive: true, signal });
	window.addEventListener("resize", updateReadingPosition, { signal });
	updateReadingPosition();

	document.querySelectorAll<HTMLAnchorElement>(".article-mobile-contents a").forEach((link) => {
		link.addEventListener("click", () => { document.querySelector<HTMLDetailsElement>(".article-mobile-contents")?.removeAttribute("open"); }, { signal });
	});
	document.getElementById("copy-article-link")?.addEventListener("click", async (event) => {
		const button = event.currentTarget as HTMLButtonElement;
		const status = document.getElementById("article-copy-status");
		try {
			await navigator.clipboard.writeText(window.location.href.split("#")[0]);
			button.textContent = "✓ 链接已复制";
			if (status) status.textContent = "文章链接已复制到剪贴板";
			window.setTimeout(() => { button.textContent = "↗ 复制文章链接"; }, 2500);
		} catch {
			button.textContent = "请复制浏览器地址";
			if (status) status.textContent = "请从浏览器地址栏复制文章链接";
		}
	}, { signal });
	}
	initializeArticle();
	document.addEventListener("astro:page-load", initializeArticle);
</script>
