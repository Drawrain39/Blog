---
import { getEntry, render } from "astro:content";
import Markdown from "@components/misc/Markdown.astro";
import ImageWrapper from "@components/misc/ImageWrapper.astro";
import MainGridLayout from "@layouts/MainGridLayout.astro";
import { profileConfig } from "../config";

const aboutPost = await getEntry("spec", "about");
if (!aboutPost) throw new Error("About page content not found");
const { Content } = await render(aboutPost);
---

<MainGridLayout title="关于我" description="Drawrain 的个人介绍、联系方式，以及一些平时的兴趣。">
	<div class="about-page">
		<header class="about-cover">
			<ImageWrapper src="assets/images/re1.jpg" alt="水面上的少女与小船" class="cover-art" />
			<div class="cover-shade"></div>
			<div class="cover-copy"><span class="page-location">首页 / 关于</span><h1>关于我</h1><p>Re / CTF / Agent(ing)</p></div>
			<div class="cover-profile"><ImageWrapper src={profileConfig.avatar || "assets/images/avata.jpg"} alt="Drawrain 的头像" class="profile-avatar" /><span>Drawrain</span></div>
		</header>
		<div class="about-columns">
			<section class="about-card bio-card"><Markdown class="about-markdown"><Content /></Markdown></section>
			<aside class="about-sidebar">
				<section class="about-card social-card"><h2><span aria-hidden="true">✧</span> 也可以在这里找到我</h2><a href="https://github.com/Drawrain39" target="_blank" rel="noopener noreferrer"><span class="social-symbol">&lt;/&gt;</span><div><strong>GitHub</strong><small>@Drawrain39</small></div><span>↗</span></a><a href="https://b23.tv/JE7bvKR" target="_blank" rel="noopener noreferrer"><span class="social-symbol">▣</span><div><strong>哔哩哔哩</strong><small>Drawrain 的 B 站主页</small></div><span>↗</span></a><a href="https://music.163.com/#/user/home?id=1704265550" target="_blank" rel="noopener noreferrer"><span class="social-symbol">♫</span><div><strong>网易云音乐</strong><small>Drawrain 的听歌主页</small></div><span>↗</span></a><a href="mailto:858617595@qq.com"><span class="social-symbol">✉</span><div><strong>联系邮箱</strong><small>858617595@qq.com</small></div><span>↗</span></a></section>
				<section class="about-card music-card"><h2><span aria-hidden="true">♫</span> 在听的歌</h2><div class="song-info"><div class="record" aria-hidden="true"><span></span></div><div><h3>ヒッチコック</h3><p>ヨルシカ · Yorushika</p><a href="https://music.163.com/#/song?id=557581315" target="_blank" rel="noopener noreferrer">去网易云听 ↗</a></div></div><button id="load-about-player" type="button" class="load-player"><span aria-hidden="true">▶</span> 加载播放器</button><iframe id="about-music-player" title="网易云音乐：ヒッチコック" data-src="https://music.163.com/outchain/player?type=2&id=557581315&auto=0&height=66" class="music-player" hidden></iframe></section>
			</aside>
		</div>
	</div>
</MainGridLayout>

<script>
	const playerButton = document.getElementById("load-about-player");
	const musicPlayer = document.getElementById("about-music-player") as HTMLIFrameElement | null;
	playerButton?.addEventListener("click", () => {
		if (!musicPlayer || !musicPlayer.dataset.src) return;
		musicPlayer.src = musicPlayer.dataset.src;
		musicPlayer.hidden = false;
		playerButton.hidden = true;
	});
</script>

<style>
	.about-page { padding-top: 30px; }
	.about-cover { position: relative; min-height: 245px; overflow: hidden; border-radius: 24px; border: 1px solid var(--line); background: var(--surface); }
	.about-cover :global(.cover-art) { position: absolute; inset: 0; width: 100%; height: 100%; }
	.about-cover :global(.cover-art img) { object-position: center 58%; }
	.cover-shade { position: absolute; inset: 0; background: linear-gradient(90deg, color-mix(in srgb, var(--surface) 95%, transparent), color-mix(in srgb, var(--surface) 20%, transparent) 75%), linear-gradient(0deg, var(--surface), transparent 80%); }
	.cover-copy { position: relative; padding: 38px; }
	.page-location { color: var(--muted); font-size: 11px; }
	.cover-copy h1 { font-size: 38px; font-weight: 700; margin: 23px 0 7px; color: var(--ink); }
	.cover-copy p { font-size: 13px; color: var(--accent); }
	.cover-profile { position: absolute; right: 38px; bottom: 28px; display: flex; align-items: center; gap: 13px; font-size: 18px; font-weight: 600; }
	.cover-profile :global(.profile-avatar) { width: 68px; height: 68px; border: 3px solid color-mix(in srgb, var(--ink) 65%, transparent); border-radius: 50%; }
	.about-columns { display: grid; grid-template-columns: minmax(0, 1.75fr) minmax(260px, 1fr); gap: 24px; margin-top: 24px; align-items: start; }
	.about-card { border: 1px solid var(--line); border-radius: 20px; background: var(--surface); padding: 27px; }
	.bio-card { padding: 32px; }
	.bio-card :global(.custom-md) { font-size: 14px; line-height: 1.95; }
	.bio-card :global(.custom-md h1) { margin-top: 0; font-size: 23px; font-weight: 600; }
	.bio-card :global(.custom-md h3) { font-size: 18px; }
	.bio-card :global(.custom-md blockquote) { border-radius: 12px; margin-bottom: 0; }
	.about-sidebar { display: grid; gap: 22px; min-width: 0; }
	.about-card h2 { margin: 0 0 20px; font-size: 15px; font-weight: 600; }
	.about-card h2 > span { color: var(--accent); margin-right: 5px; }
	.social-card > a { display: flex; align-items: center; gap: 11px; padding: 13px 0; color: var(--ink); border-bottom: 1px solid var(--line); }
	.social-card > a:last-child { padding-bottom: 0; border-bottom: 0; }
	.social-card > a > div { flex: 1; min-width: 0; }
	.social-symbol { display: grid; place-items: center; width: 37px; height: 37px; border-radius: 12px; background: var(--soft); color: var(--accent); font-size: 18px; }
	.social-card strong { display: block; font-size: 13px; font-weight: 500; }
	.social-card small { display: block; margin-top: 3px; font-size: 10px; color: var(--muted); overflow-wrap: anywhere; }
	.social-card > a > span:last-child { color: var(--muted); font-size: 18px; }
	.social-card > a:hover strong, .social-card > a:hover > span:last-child { color: var(--accent); }
	.song-info { display: flex; gap: 16px; align-items: center; }
	.record { display: grid; place-items: center; width: 76px; height: 76px; flex: 0 0 auto; border: 1px solid var(--line); border-radius: 50%; background: repeating-radial-gradient(circle, var(--paper) 0px, var(--paper) 2px, var(--soft) 3px, var(--paper) 4px); }
	.record span { width: 26px; height: 26px; border: 10px solid var(--accent); border-radius: 50%; background: var(--paper); }
	.song-info h3 { font-size: 17px; font-weight: 500; margin: 0 0 5px; }
	.song-info p { font-size: 10px; color: var(--muted); }
	.song-info a { display: inline-block; margin-top: 10px; font-size: 11px; color: var(--accent); }
	.load-player { width: 100%; border: 1px solid var(--line); border-radius: 12px; background: var(--soft); padding: 12px; margin-top: 22px; font-size: 12px; color: var(--ink); }
	.load-player span { color: var(--accent); margin-right: 7px; }
	.load-player:hover { border-color: var(--accent); }
	.music-player { width: 100%; height: 86px; border: 0; margin-top: 18px; border-radius: 10px; }
	@media (max-width: 850px) { .about-columns { grid-template-columns: 1fr; } .about-sidebar { grid-template-columns: 1fr 1fr; align-items: start; } .about-card { padding: 23px; } }
	@media (max-width: 600px) { .about-page { padding-top: 20px; } .about-cover { min-height: 235px; border-radius: 18px; } .cover-copy { padding: 25px; } .cover-copy h1 { font-size: 32px; margin-top: 22px; } .cover-profile { right: 23px; bottom: 22px; font-size: 13px; } .cover-profile > span { display: none; } .cover-profile :global(.profile-avatar) { width: 48px; height: 48px; } .about-sidebar { grid-template-columns: 1fr; } .about-columns { gap: 18px; margin-top: 18px; } .bio-card { padding: 24px; } }
</style>
