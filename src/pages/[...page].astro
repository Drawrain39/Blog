---
import type { GetStaticPaths } from "astro";
import { Image } from "astro:assets";
import MainGridLayout from "../layouts/MainGridLayout.astro";
import PostPage from "../components/PostPage.astro";
import Brand from "../components/Brand.astro";
import Pagination from "../components/control/Pagination.astro";
import { getSortedPosts } from "../utils/content-utils";
import { getCategoryUrl, getPostUrlBySlug, url } from "../utils/url-utils";
import { PAGE_SIZE } from "../constants/constants";
import { friendLinks } from "../constants/friends";
import avatar from "../assets/images/avata.jpg";
import dayArt from "../assets/images/sky-reflection.jpg";
import profileArt from "../assets/images/re1.jpg";

export const getStaticPaths = (async ({ paginate }) => paginate((await getSortedPosts()).filter(post => !post.data.hideInHome), { pageSize: PAGE_SIZE })) satisfies GetStaticPaths;
const { page } = Astro.props;
const allPosts = await getSortedPosts();
const homePosts = allPosts.filter(post => !post.data.hideInHome);
const featuredPosts = homePosts.filter(post => post.data.featured).sort((a,b) => a.data.featuredOrder-b.data.featuredOrder).slice(0,3);
const posts = page.currentPage === 1 ? homePosts : page.data;
const categories = allPosts.reduce((counts, post) => {
  const category = post.data.category || "随记";
  counts[category] = (counts[category] || 0) + 1;
  return counts;
}, {} as Record<string, number>);
const lastUpdated = homePosts[0]?.data.published.toISOString().slice(0,10);
---
<MainGridLayout homePage={true}>
  <section slot="hero" class="home-scene" aria-labelledby="home-title">
    <div class="scene-art">
      <Image src={dayArt} widths={[800,1280,1600,1920]} sizes="(max-width: 420px) 870px, (max-width: 760px) 920px, (max-width: 1120px) 1120px, 100vw" format="webp" quality={95} loading="eager" fetchpriority="high" alt="晴空下的白发少女与水面倒映的云朵、相机和画具" class="scene-image" />
    </div>
    <div class="scene-shade" aria-hidden="true"></div>
    <div class="sky-glints" aria-hidden="true"><span>✦</span><span>✧</span><span>✦</span></div>
    <div class="scene-content site-container">
      <div class="scene-copy">
      <h1 id="home-title"><span class="sr-only">Drawrain</span><Brand variant="wordmark" class="scene-wordmark" /><span class="name-note">の小站</span></h1>
      <p class="scene-motto">Just keep drawing <br />without regrets.</p>
      <p class="scene-description">Reverse / CTF / AI</p>
      <a href="#posts" class="scene-down"><svg viewBox="0 0 24 24" width="17" height="17" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true"><path d="M12 4v15m-5-5 5 5 5-5" /></svg> 往下看看</a>
      </div>
    </div>
    <div class="scene-bottom site-container"><span class="scene-quote">“即使迷茫，也要前行。”</span><button class="scene-motion-toggle" type="button" aria-label="暂停背景动画" title="暂停背景动画" data-motion-toggle><svg class="motion-pause" viewBox="0 0 20 20" width="14" height="14" fill="currentColor" aria-hidden="true"><path d="M5 4h3v12H5zm7 0h3v12h-3z"/></svg><svg class="motion-play" viewBox="0 0 20 20" width="14" height="14" fill="currentColor" aria-hidden="true"><path d="m6 4 9 6-9 6z"/></svg></button></div>
  </section>

  <div class="home-layout">
    <aside class="home-sidebar" aria-label="Drawrain 的个人空间">
      <section class="profile-panel">
        <div class="profile-cover"><Image src={profileArt} width={500} format="webp" alt="" /></div>
        <a href={url("/about/")} class="profile-avatar" aria-label="关于 Drawrain"><Image src={avatar} width={100} height={100} format="webp" alt="Drawrain 的头像" /></a>
        <h2>Drawrain <span aria-hidden="true">✧</span></h2>
        <p class="profile-bio">计科本科在读<br />Reverse / CTF / AI</p>
        <div class="profile-tags"><a href={getCategoryUrl("CTF")}>CTF</a><a href={url("/archive/?tag=Reverse")}>Reverse</a><a href={getCategoryUrl("AI")}>AI Agent</a></div>
        <div class="profile-stats"><a href={url("/archive/")}><strong>{allPosts.length}</strong><span>文章</span></a><a href={url("/archive/")}><strong>{Object.keys(categories).length}</strong><span>分类</span></a><a href={url("/friends/")}><strong>{friendLinks.length}</strong><span>朋友</span></a></div>
        <div class="profile-links"><a href="https://github.com/Drawrain39" target="_blank" rel="noopener noreferrer"><svg viewBox="0 0 24 24" width="17" height="17" fill="none" stroke="currentColor" stroke-width="1.6" aria-hidden="true"><path d="m8 5-6 7 6 7m8-14 6 7-6 7m-3-16-2 18" /></svg>GitHub</a></div>
      </section>
      <section class="sidebar-note"><h2><span aria-hidden="true">⌁</span> 这里写些什么</h2><p>平时比赛的 WP、学习相关的知识，偶尔也会写点别的。</p><a href={url("/about/")}>成分复杂，等待挖掘… <span aria-hidden="true">↗</span></a></section>
      <section class="sidebar-topics"><h2><svg viewBox="0 0 20 20" width="15" height="15" fill="none" stroke="currentColor" stroke-width="1.4" aria-hidden="true"><path d="M2 4h6l2 2h8v11H2Z"/></svg>文章分类</h2>{Object.entries(categories).sort((a,b)=>b[1]-a[1]).map(([category,count])=><a href={getCategoryUrl(category)}><span>{category}</span><span>{count}</span></a>)}</section>
    </aside>

    <section class="home-feed" id="posts" aria-labelledby="posts-title">
      {page.currentPage === 1 && featuredPosts.length > 0 && <section class="featured-block" aria-labelledby="featured-title">
        <div class="featured-heading"><div class="heading-copy"><span class="section-eyebrow" aria-hidden="true">✦ FEATURED</span><h2 id="featured-title">精选文章 <span aria-hidden="true">⌖</span></h2></div><a href={url("/archive/?category=CTF")}>比赛记录 →</a></div>
        <div class="featured-grid">{featuredPosts.map(entry => <a class="featured-card" href={getPostUrlBySlug(entry.slug)}><div class="featured-card-copy">
          <div class="featured-card-meta"><span>{entry.data.category}</span><span class="featured-card-star" aria-hidden="true">✦</span></div>
          <h3>{entry.data.title}</h3>
          {entry.data.description && <p class="featured-description">{entry.data.description}</p>}
          <div class="featured-card-footer"><time datetime={entry.data.published.toISOString()}>{entry.data.published.toISOString().slice(0,10)}</time><span aria-hidden="true">↗</span></div>
        </div></a>)}</div>
      </section>}
      <header class="feed-heading"><div class="heading-copy"><span class="section-eyebrow" aria-hidden="true">✦ RECENT POSTS</span><h2 id="posts-title">最近更新<span class="heading-star" aria-hidden="true">✦</span></h2></div><a href={url("/archive/")}>全部文章 <span aria-hidden="true">→</span></a></header>
      <PostPage posts={posts} />
      {page.currentPage !== 1 && <Pagination page={page} class="legacy-pagination" style="" />}
      <p class="last-update">最近一篇记录于 <time datetime={lastUpdated}>{lastUpdated}</time></p>
    </section>
  </div>
</MainGridLayout>

<script>
  let sceneController: AbortController | undefined;

  function initializeAmbient(scene: HTMLElement, signal: AbortSignal) {
    const reducedMotion = matchMedia("(prefers-reduced-motion: reduce)");
    const button = scene.querySelector<HTMLButtonElement>("[data-motion-toggle]");
    let paused = false;
    let visible = scene.getBoundingClientRect().bottom > 0;
    try { paused = localStorage.getItem("drawrain-motion-v1") === "paused"; } catch { /* The control also works without storage. */ }
    const sync = () => {
      scene.toggleAttribute("data-ambient-running", visible && !document.hidden && !paused && !reducedMotion.matches);
      scene.toggleAttribute("data-ambient-paused", paused);
      if (button) {
        button.hidden = reducedMotion.matches;
        const label = paused ? "播放背景动画" : "暂停背景动画";
        button.setAttribute("aria-label", label);
        button.title = label;
      }
      scene.dispatchEvent(new Event("drawrain:motion-change"));
    };
    const observer = new IntersectionObserver(entries => { visible = entries[0]?.isIntersecting ?? false; sync(); });
    observer.observe(scene);
    button?.addEventListener("click", () => {
      paused = !paused;
      try { localStorage.setItem("drawrain-motion-v1", paused ? "paused" : "playing"); } catch { /* Keep this preference for the current page. */ }
      sync();
    }, { signal });
    document.addEventListener("visibilitychange", sync, { signal });
    reducedMotion.addEventListener("change", sync, { signal });
    signal.addEventListener("abort", () => { observer.disconnect(); scene.removeAttribute("data-ambient-running"); }, { once: true });
    sync();
  }

  function initializeParallax(scene: HTMLElement, signal: AbortSignal) {
    const desktopMotion = matchMedia("(min-width: 1001px) and (hover: hover) and (pointer: fine) and (prefers-reduced-motion: no-preference)");
    let frame = 0;
    let visible = scene.getBoundingClientRect().bottom > 0;
    const cancelFrame = () => { cancelAnimationFrame(frame); frame = 0; };
    const paint = () => {
      frame = 0;
      if (!desktopMotion.matches || document.hidden || !visible || scene.hasAttribute("data-ambient-paused")) return;
      const offset = Math.min(12, Math.max(0, -scene.getBoundingClientRect().top * .025));
      scene.style.setProperty("--scene-drift", `${offset.toFixed(2)}px`);
    };
    const queue = () => {
      if (!frame && desktopMotion.matches && visible && !document.hidden && !scene.hasAttribute("data-ambient-paused")) frame = requestAnimationFrame(paint);
    };
    const resetOrQueue = () => {
      if (!desktopMotion.matches) { cancelFrame(); scene.style.removeProperty("--scene-drift"); }
      else queue();
    };
    const observer = new IntersectionObserver(entries => {
      visible = entries[0]?.isIntersecting ?? false;
      if (visible) queue(); else cancelFrame();
    });
    observer.observe(scene);
    window.addEventListener("scroll", queue, { passive: true, signal });
    scene.addEventListener("drawrain:motion-change", () => scene.hasAttribute("data-ambient-paused") ? cancelFrame() : queue(), { signal });
    window.addEventListener("resize", resetOrQueue, { passive: true, signal });
    desktopMotion.addEventListener("change", resetOrQueue, { signal });
    document.addEventListener("visibilitychange", () => document.hidden ? cancelFrame() : queue(), { signal });
    signal.addEventListener("abort", () => {
      cancelFrame(); observer.disconnect(); scene.style.removeProperty("--scene-drift");
    }, { once: true });
    queue();
  }

  function initializeScene() {
    sceneController?.abort();
    const scene = document.querySelector<HTMLElement>(".home-scene");
    if (!scene) return;
    sceneController = new AbortController();
    const { signal } = sceneController;
    initializeAmbient(scene, signal);
    initializeParallax(scene, signal);
  }

  initializeScene();
  document.addEventListener("astro:page-load", initializeScene);
  document.addEventListener("astro:before-swap", () => sceneController?.abort());
</script>

<style>
  :global(html:has(> body.home-page)) { scroll-padding-top: 0; }
  .home-scene { --hero-ink: #f8fcff; --hero-muted: #e3f2ff; --scene-rain: #b4ebef; --scene-star: #d1f0df; position: relative; width: 100%; height: clamp(580px,70svh,680px); margin: 0; overflow: hidden; background: var(--paper); color: var(--hero-ink); isolation: isolate; }
  .scene-art { position: absolute; inset: 0; z-index: 0; background: #2276ac; mask-image: linear-gradient(#000 70%,#000e 84%,#0007 94%,transparent); -webkit-mask-image: linear-gradient(#000 70%,#000e 84%,#0007 94%,transparent); }
  .scene-image { position: absolute; top: 76px; left: 0; width: 100%; height: calc(100% - 52px); object-fit: cover; object-position: center top; }
  .scene-shade { position: absolute; inset: 0; z-index: 1; pointer-events: none; background: linear-gradient(90deg,transparent 30%,#153d602b 58%,#173e626b),linear-gradient(0deg,#183e6355,transparent 50%); mask-image: linear-gradient(#000 68%,#000a 85%,transparent); -webkit-mask-image: linear-gradient(#000 68%,#000a 85%,transparent); }
  .scene-content { position: relative; z-index: 3; display: flex; align-items: center; width: min(1180px,calc(100% - 48px)); height: 100%; margin: 0 auto; padding: 120px 0 78px; }
  .scene-copy { width: 47%; max-width: 540px; margin-left: auto; }
  h1 { --brand-rain: var(--scene-rain); --brand-star: var(--scene-star); font-size: clamp(60px,5.8vw,88px); font-weight: 750; line-height: 1.15; margin: 0 0 18px; letter-spacing: -.035em; }
  h1 :global(.scene-wordmark) { display: inline-block; width: 4.8em; height: auto; vertical-align: middle; filter: drop-shadow(0 4px 12px #12365466); }
  .name-note { display: inline-block; font-size: 15px; font-weight: 500; letter-spacing: .12em; margin-left: 14px; transform: rotate(-6deg); color: var(--scene-star); text-shadow: 0 2px 6px #12365466; }
  .sr-only { position: absolute; width: 1px; height: 1px; padding: 0; margin: -1px; overflow: hidden; clip: rect(0,0,0,0); white-space: nowrap; border: 0; }
  .scene-motto { color: var(--hero-muted); font-size: 16px; line-height: 1.8; letter-spacing: .01em; margin: 0 0 16px; text-shadow: 0 2px 6px #12365480; }
  .scene-motto br { display: none; }
  .scene-description { color: var(--hero-muted); font: 11px/1.8 var(--font-mono); letter-spacing: .06em; margin: 0; text-shadow: 0 2px 5px #12365499; }
  .scene-down { display: inline-flex; align-items: center; gap: 9px; margin-top: 25px; font-size: 12px; padding: 9px 16px 9px 13px; border: 1px solid #d4efff70; border-radius: 30px; background: #244d7180; color: var(--hero-ink); backdrop-filter: blur(8px); transition: background .2s,border-color .2s,transform .2s; }
  .scene-down svg { color: var(--scene-rain); animation: scene-arrow 3.6s ease-in-out infinite; animation-play-state: paused; }
  .scene-down:hover { background: #244d71b3; border-color: #d4efff; transform: translateY(-1px); }
  [data-ambient-running] .scene-down svg { animation-play-state: running; }
  @keyframes scene-arrow { 0%,70%,100% { transform: translateY(0); } 35% { transform: translateY(3px); } }
  .sky-glints { position: absolute; inset: 0; z-index: 2; pointer-events: none; }
  .sky-glints span { position: absolute; left: 45%; top: 22%; color: #f3fffe; font-size: 10px; line-height: 1; opacity: .5; animation: sky-glint 3.6s ease-in-out infinite; animation-play-state: paused; }
  .sky-glints span:nth-child(2) { left: 89%; top: 23%; font-size: 8px; animation-delay: -1.2s; }
  .sky-glints span:nth-child(3) { left: 85%; top: 70%; font-size: 7px; animation-delay: -2.4s; }
  [data-ambient-running] .sky-glints span { animation-play-state: running; }
  @keyframes sky-glint { 0%,100% { transform: translate3d(0,0,0) rotate(-6deg) scale(.9); opacity: .4; } 50% { transform: translate3d(3px,-6px,0) rotate(10deg) scale(1.12); opacity: .8; } }
  .scene-bottom { position: absolute; z-index: 4; inset: auto 0 57px; display: flex; justify-content: space-between; align-items: center; width: min(1180px,calc(100% - 48px)); margin: 0 auto; gap: 20px; }
  .scene-quote { font-size: 10px; color: #315a75; letter-spacing: .06em; text-shadow: 0 1px 2px #ffffff80; }
  .scene-motion-toggle { display: grid; place-items: center; flex: 0 0 30px; width: 30px; height: 30px; margin-left: auto; padding: 0; border: 1px solid #d4efff70; border-radius: 50%; background: #244d7180; color: #effaff; backdrop-filter: blur(8px); transition: background .18s,border-color .18s; }
  .scene-motion-toggle:hover,.scene-motion-toggle:focus-visible { background: #244d71b3; border-color: #d4efff; }
  .motion-play { display: none; margin-left: 1px; }
  [data-ambient-paused] .motion-play { display: block; }
  [data-ambient-paused] .motion-pause { display: none; }
  .home-layout { position: relative; display: grid; grid-template-columns: 264px minmax(0,1fr); align-items: start; gap: 24px; margin-top: -30px; }
  .home-sidebar { min-width: 0; position: sticky; top: 20px; align-self: start; max-height: calc(100dvh - 40px); overflow-y: auto; overscroll-behavior-y: contain; scrollbar-width: thin; scrollbar-color: var(--scrollbar-thumb) transparent; padding: 0 2px 3px; }
  .profile-panel { position: relative; text-align: center; background: var(--surface); border: 1px solid #e5eef580; border-radius: 22px; overflow: hidden; box-shadow: var(--panel-shadow); padding-bottom: 20px; }
  .profile-cover { height: 100px; overflow: hidden; position: relative; }
  .profile-cover img { width: 100%; height: 100%; object-fit: cover; object-position: 70% 25%; }
  .profile-cover::after { content: ""; position: absolute; inset: 0; background: linear-gradient(transparent 65%,#ffffff33); }
  .profile-avatar { position: relative; display: block; width: 80px; height: 80px; margin: -38px auto 12px; border: 5px solid var(--surface); border-radius: 50%; overflow: hidden; transition: transform .25s; }
  .profile-avatar:hover { transform: translateY(-2px); }
  .profile-avatar img { width: 100%; height: 100%; object-fit: cover; }
  .profile-panel h2 { font-size: 23px; line-height: 1.4; font-weight: 650; margin: 0 0 9px; letter-spacing: -.03em; }
  .profile-panel h2 > span { margin-left: 3px; color: var(--accent); font-size: 17px; }
  .profile-bio { color: var(--muted); font-size: 12px; line-height: 1.9; margin: 0; }
  .profile-tags { display: flex; gap: 6px; justify-content: center; margin: 15px 0 18px; }
  .profile-tags a { background: var(--soft); color: var(--accent); border-radius: 8px; font-size: 10px; padding: 3px 8px; }
  .profile-stats { display: flex; margin: 0 20px; padding: 0 0 16px; border-bottom: 1px solid var(--line); }
  .profile-stats > a { display: flex; flex: 1; flex-direction: column; line-height: 1.7; }
  .profile-stats strong { font-size: 21px; font-weight: 650; }
  .profile-stats a:hover strong { color: var(--accent); }
  .profile-stats span { color: var(--muted); font-size: 10px; }
  .profile-links { display: flex; justify-content: center; margin-top: 15px; }
  .profile-links a { display: inline-flex; gap: 7px; align-items: center; font-size: 12px; color: var(--muted); }
  .profile-links a:hover { color: var(--accent); }
  .sidebar-note { padding: 22px 17px; margin-top: 2px; }
  .sidebar-note h2,.sidebar-topics h2 { display: flex; align-items: center; gap: 8px; font-size: 13px; font-weight: 600; margin: 0 0 12px; }
  .sidebar-note h2 > span { color: var(--accent); font-size: 20px; }
  .sidebar-note p { color: var(--muted); font-size: 12px; line-height: 1.95; margin: 0 0 10px; }
  .sidebar-note > a { font-size: 11px; color: var(--accent); }
  .sidebar-note > a > span { margin-left: 5px; }
  .sidebar-topics { padding: 22px; background: var(--surface); border: 1px solid #e5eef580; border-radius: 22px; box-shadow: var(--panel-shadow); }
  .sidebar-topics h2 svg { color: var(--accent); }
  .sidebar-topics > a { display: flex; justify-content: space-between; padding: 7px 0; font-size: 12px; color: var(--muted); }
  .sidebar-topics > a:hover { color: var(--accent); }
  .sidebar-topics > a > span:last-child { display: grid; place-items: center; min-width: 23px; padding: 0 6px; border-radius: 7px; background: var(--soft); color: var(--accent); font-size: 10px; }
  .home-feed { min-width: 0; padding-top: 54px; scroll-margin-top: 24px; }
  .heading-copy { min-width: 0; }
  .section-eyebrow { display: block; margin-bottom: 5px; color: var(--muted); font: 500 9px/1.4 var(--font-mono); letter-spacing: .14em; opacity: .8; }
  .feed-heading { display: flex; justify-content: space-between; align-items: center; margin-bottom: 18px; gap: 12px; }
  .feed-heading h2 { font-size: 24px; font-weight: 650; line-height: 1.4; margin: 0; letter-spacing: -.035em; }
  .heading-star { font-size: 13px; color: var(--accent); margin-left: 8px; vertical-align: middle; }
  .feed-heading > a { display: flex; gap: 9px; align-items: center; font-size: 11px; color: var(--muted); }
  .feed-heading > a:hover { color: var(--accent); }
  .last-update { color: var(--muted); font-size: 11px; text-align: center; margin: 24px 0 0; }
  :global(.dark) .scene-shade { background: linear-gradient(90deg,transparent 28%,#16344955 60%,#14304788),linear-gradient(0deg,#142a3a55,transparent 48%); }
  :global(.dark) .scene-quote { color: #d4e7ef; text-shadow: 0 1px 3px #163449; }
  :global(.dark) .profile-panel,:global(.dark) .sidebar-topics { border-color: var(--line); }
  @media (max-width: 1000px) { .home-layout { grid-template-columns: 230px minmax(0,1fr); gap: 20px; } .scene-copy { width: 48%; } h1 { font-size: clamp(50px,6vw,60px); } .name-note { font-size: 12px; margin-left: 10px; } }
  @media (max-width: 760px) {
    .home-scene { height: 565px; }
    .scene-image { top: 74px; height: calc(100% - 50px); object-position: 18% top; }
    .scene-shade { background: linear-gradient(0deg,#153f73cc 18%,#153f7380 37%,#173e6200 68%); mask-image: linear-gradient(#000 74%,#000b 88%,transparent); -webkit-mask-image: linear-gradient(#000 74%,#000b 88%,transparent); }
    .scene-content { width: calc(100% - 32px); align-items: flex-end; padding: 0 0 68px; }
    .scene-copy { width: 100%; max-width: none; }
    h1 { font-size: 52px; margin-bottom: 12px; }
    .name-note { font-size: 12px; margin-left: 10px; }
    .scene-motto { font-size: 14px; margin-bottom: 10px; }
    .scene-description { font-size: 11px; }
    .scene-down { margin-top: 14px; padding: 7px 12px; font-size: 11px; }
    .scene-bottom { inset: auto 0 27px; width: calc(100% - 32px); }
    .scene-quote { display: none; }
    .scene-motion-toggle { width: 28px; height: 28px; flex-basis: 28px; }
    .sky-glints span:first-child { left: 86%; top: 22%; font-size: 8px; }
    .sky-glints span:not(:first-child) { display: none; }
    .home-layout { grid-template-columns: minmax(0,1fr); margin-top: 24px; }
    .home-feed { padding-top: 0; }
    .home-sidebar { display: none; }
    .feed-heading h2 { font-size: 22px; }
    :global(.dark) .scene-shade { background: linear-gradient(0deg,#163449dd 18%,#16344999 37%,#16344900 68%); }
  }
  @media (max-width: 420px) { .home-scene { height: 540px; } h1 { font-size: clamp(42px,12.8vw,52px); } h1 :global(.scene-wordmark) { width: min(4.8em,calc(100vw - 118px)); } .name-note { margin-left: 8px; font-size: 11px; } .scene-motto { font-size: 14px; letter-spacing: -.01em; } }
  @media (min-width: 1001px) and (hover: hover) and (pointer: fine) and (prefers-reduced-motion: no-preference) { .scene-image { transform: translate3d(0,var(--scene-drift,0px),0); } }
  @media (prefers-reduced-motion: reduce) { .scene-image,.profile-avatar:hover,.scene-down:hover { transform: none; } .sky-glints span,.scene-down svg { animation: none; } .scene-motion-toggle { display: none; } .scene-down,.name-note,.profile-avatar { transition: none; } }
</style>
