---
import EnglishB2QuizApp from "@components/EnglishB2Quiz.svelte";
import Navbar from "@components/Navbar.astro";
import Footer from "@components/Footer.astro";
import Layout from "@layouts/Layout.astro";
import { parseEnglishB2Quiz } from "@utils/english-b2-quiz";
import { url } from "@utils/url-utils";
import englishB2Markdown from "../content/posts/EnglishB2.md?raw";
import "../styles/study.css";

const questions = parseEnglishB2Quiz(englishB2Markdown);
---

<Layout title="大学英语 B2 刷题模式" description="大学英语 B2 期末复习刷题页面，支持按单元练习、错题复习、收藏和解析。" bodyClass="study-page english-study-page">
	<Navbar />
	<main id="main-content" class="study-workspace site-container" tabindex="-1">
		<nav class="study-trail" aria-label="刷题页面导航"><span>STUDY NOTES / ENGLISH B2</span><div><a href={url("/posts/englishb2/")}>← 复习原文</a><a href={url("/archive/")}>全部文章 ↗</a></div></nav>
		<EnglishB2QuizApp questions={questions} client:load />
	</main>
	<div class="site-container"><Footer /></div>
</Layout>
